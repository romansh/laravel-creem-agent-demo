# Agent application example environment file.
# Copy to app/.env before starting Docker if you want to preconfigure
# tokens, secrets, and webhook URLs.

APP_NAME="Creem Demo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database (the app uses SQLite by default)
# Docker overrides DB_DATABASE to /var/lib/agent-app/database.sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_URL=

CREEM_AGENT_DEFAULT_STORE=default
CREEM_AGENT_TELEGRAM_MODE=laravel
CREEM_AGENT_TELEGRAM_TOKEN=your_telegram_bot_token_here
CREEM_AGENT_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
CREEM_AGENT_SLACK_WEBHOOK=
CREEM_AGENT_DISCORD_WEBHOOK=

CREEM_AGENT_OPENCLAW=false
OPENCLAW_ENDPOINT=http://127.0.0.1:4110
OPENCLAW_WORKSPACE_PATH=/home/openclaw/.openclaw/workspace
OPENCLAW_SHARED_SECRET=change-me

CREEM_AGENT_LLM_ENABLED=true
CREEM_AGENT_LLM_PROVIDER=openai
CREEM_AGENT_LLM_MODEL=gpt-4o-mini
#CREEM_AGENT_LLM_PROVIDER=gemini
#CREEM_AGENT_LLM_MODEL=gemini-2.5-flash-lite
CREEM_AGENT_LLM_TIMEOUT=30
CREEM_AGENT_LLM_FALLBACK_TO_RULES=true

OPENAI_API_KEY=sk-...
OPENAI_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

CREEM_TEST_MODE=true
CREEM_API_KEY=creem_test_XXXXXXXXXXXXXXXXXXXX
CREEM_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX
CREEM_API_URL=http://simulator/api/v1
CREEM_TEST_API_URL=http://simulator/api/v1

CREEM_SECONDARY_API_KEY=creem_test_YYYYYYYYYYYYYYYYYYYY
CREEM_SECONDARY_WEBHOOK_SECRET=whsec_YYYYYYYYYYYYYYYYYYYY
CREEM_SECONDARY_API_URL=http://simulator/api/v1

CREEM_SIMULATOR_DEFAULT_API_KEY=${CREEM_API_KEY}
CREEM_SIMULATOR_DEFAULT_WEBHOOK_SECRET=${CREEM_WEBHOOK_SECRET}
CREEM_SIMULATOR_SECONDARY_API_KEY=${CREEM_SECONDARY_API_KEY}
CREEM_SIMULATOR_SECONDARY_WEBHOOK_SECRET=${CREEM_SECONDARY_WEBHOOK_SECRET}
CREEM_SIMULATOR_AGENT_WEBHOOK_URL=http://app/creem/webhook
CREEM_SIMULATOR_AGENT_WEBHOOK_SECRET=${CREEM_WEBHOOK_SECRET}
CREEM_SIMULATOR_AUTO_SEND_WEBHOOKS=false