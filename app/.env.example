# Project-wide example environment file.
# Fill these placeholders before the first Docker run if you want to preconfigure
# tokens, secrets and public URLs. For simulator-only local runs you can skip
# NGROK_AUTHTOKEN and start ngrok later.

APP_NAME="Creem Demo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Common Laravel/runtime settings (useful when copying .env.example -> .env)
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database (demo uses SQLite by default)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_DATABASE=database/database.sqlite

CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Mail (log driver is safe for local dev)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

# Optional: ngrok authtoken (only needed if you plan to run ngrok now)
NGROK_AUTHTOKEN=demo_ngrok_authtoken
NGROK_URL=

# Notification / chat integrations (custom settings)
CREEM_AGENT_DEFAULT_STORE=default
CREEM_AGENT_TELEGRAM_MODE=laravel
#CREEM_AGENT_TELEGRAM_MODE=openclaw
CREEM_AGENT_TELEGRAM_TOKEN=123456789:demo-telegram-bot-token
CREEM_AGENT_TELEGRAM_CHAT_ID=123456789
CREEM_AGENT_SLACK_WEBHOOK=
CREEM_AGENT_DISCORD_WEBHOOK=

# OpenClaw (optional)
CREEM_AGENT_OPENCLAW=false
OPENCLAW_ENDPOINT=http://127.0.0.1:4110
OPENCLAW_WORKSPACE_PATH=/home/openclaw/.openclaw/workspace
OPENCLAW_SHARED_SECRET=demo-openclaw-shared-secret
OPENCLAW_TELEGRAM_BOT_TOKEN=${CREEM_AGENT_TELEGRAM_TOKEN}

# Agent LLM routing (Laravel AI SDK)
# By default the agent will follow the SkillEngine defaults; to force
# the Crawler-specific Gemini override set the CRAWLER_LLM_* vars or
# explicitly set the CREEM_AGENT_LLM_PROVIDER/CREEM_AGENT_LLM_MODEL.
CREEM_AGENT_LLM_ENABLED=true
CREEM_AGENT_LLM_PROVIDER=openai
CREEM_AGENT_LLM_MODEL=gpt-4o-mini
#CREEM_AGENT_LLM_PROVIDER=gemini
#CREEM_AGENT_LLM_MODEL=gemini-2.5-flash-lite
CREEM_AGENT_LLM_TIMEOUT=30
CREEM_AGENT_LLM_FALLBACK_TO_RULES=true

# Provider credentials for Laravel AI SDK
OPENAI_API_KEY=sk-demo-openai-key
OPENAI_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=demo-gemini-api-key
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Creem API keys & URLs (moved from top to keep Laravel defaults first)
CREEM_TEST_MODE=true
CREEM_API_KEY=creem_test_demo_default
CREEM_WEBHOOK_SECRET=whsec_demo_default
CREEM_API_URL=http://simulator/api/v1
CREEM_TEST_API_URL=http://simulator/api/v1

# Optional secondary/alternate Creem store (multi-store demos)
# If you run a secondary store, set these before initialization so the
# published config can map profiles automatically.
CREEM_SECONDARY_API_KEY=creem_test_demo_secondary
CREEM_SECONDARY_WEBHOOK_SECRET=whsec_demo_secondary
CREEM_SECONDARY_API_URL=http://simulator/api/v1

## Simulator default keys & webhook settings (reused from Creem main values)
CREEM_SIMULATOR_DEFAULT_API_KEY=${CREEM_API_KEY}
CREEM_SIMULATOR_DEFAULT_WEBHOOK_SECRET=${CREEM_WEBHOOK_SECRET}
CREEM_SIMULATOR_SECONDARY_API_KEY=${CREEM_SECONDARY_API_KEY}
CREEM_SIMULATOR_SECONDARY_WEBHOOK_SECRET=${CREEM_SECONDARY_WEBHOOK_SECRET}
## If the simulator should call the agent app inside the same Docker network,
## the default internal URL is `http://app/creem/webhook`. If you publish the
## simulator port and want the simulator to call the host/ngrok URL instead,
## override this before starting ngrok.
CREEM_SIMULATOR_AGENT_WEBHOOK_URL=http://app/creem/webhook
CREEM_SIMULATOR_AGENT_WEBHOOK_SECRET=${CREEM_WEBHOOK_SECRET}
CREEM_SIMULATOR_AUTO_SEND_WEBHOOKS=false
