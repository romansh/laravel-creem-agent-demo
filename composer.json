{
  "name": "romansh/laravel-creem-agent-demo",
  "description": "Demo application glue for laravel-creem packages (GitHub VCS repositories)",
  "type": "project",
  "require": {
    "php": "^8.2",
    "romansh/laravel-creem": "^1.2",
    "romansh/laravel-creem-cli": "dev-main as 1.2",
    "romansh/laravel-creem-agent": "dev-main as 1.2"
  },
  "repositories": [
    { "type": "vcs", "url": "git@github-laravel-creem:romansh/laravel-creem.git", "no-api": true },
    { "type": "vcs", "url": "git@github-laravel-creem-cli:romansh/laravel-creem-cli.git", "no-api": true },
    { "type": "vcs", "url": "git@github-laravel-creem-agent:romansh/laravel-creem-agent.git", "no-api": true }
  ],
  "autoload": {
    "psr-4": {
      "Demo\\": "app/"
    }
  },
  "config": {
    "use-github-api": false
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
